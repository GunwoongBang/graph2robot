  </joint>
  <joint name="ur_arm_shoulder_pan_joint" type="revolute">
    <parent link="ur_arm_base_link_inertia"/>
    <child link="ur_arm_shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ur_arm_shoulder_lift_joint" type="revolute">
    <parent link="ur_arm_shoulder_link"/>
    <child link="ur_arm_upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ur_arm_elbow_joint" type="revolute">
    <parent link="ur_arm_upper_arm_link"/>
    <child link="ur_arm_forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ur_arm_wrist_1_joint" type="revolute">
    <parent link="ur_arm_forearm_link"/>
    <child link="ur_arm_wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ur_arm_wrist_2_joint" type="revolute">
    <parent link="ur_arm_wrist_1_link"/>
    <child link="ur_arm_wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 -2.044881182297852e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ur_arm_wrist_3_joint" type="revolute">
    <parent link="ur_arm_wrist_2_link"/>
    <child link="ur_arm_wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ur_arm_ft_frame"/>
  <joint name="ur_arm_wrist_3_link-ft_frame" type="fixed">
    <parent link="ur_arm_wrist_3_link"/>
    <child link="ur_arm_ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="ur_arm_base"/>
  <joint name="ur_arm_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="ur_arm_base_link"/>
    <child link="ur_arm_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="ur_arm_flange"/>
  <joint name="ur_arm_wrist_3-flange" type="fixed">
    <parent link="ur_arm_wrist_3_link"/>
    <child link="ur_arm_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="ur_arm_tool0"/>
  <joint name="ur_arm_flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="ur_arm_flange"/>
    <child link="ur_arm_tool0"/>
  </joint>

  <!-- Drill end-effector: 20 mm Ø x 120 mm cylindrical shank + 30 mm conical tip.
       drill_tip frame sits at the very point of the cone (150 mm along tool0 +z). -->
  <link name="drill_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.060"/>
      <geometry>
        <cylinder length="0.120" radius="0.010"/>
      </geometry>
      <material name="drill_gray">
        <color rgba="0.35 0.35 0.38 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.120"/>
      <geometry>
        <mesh filename="package://robot_gazebo/models/robots/drill_meshes/drill_cone.stl"/>
      </geometry>
      <material name="drill_gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.075"/>
      <geometry>
        <cylinder length="0.150" radius="0.010"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.075"/>
      <mass value="0.05"/>
      <inertia ixx="9.5e-5" ixy="0" ixz="0" iyy="9.5e-5" iyz="0" izz="2.5e-6"/>
    </inertial>
  </link>
  <joint name="tool0_to_drill" type="fixed">
    <parent link="ur_arm_tool0"/>
    <child link="drill_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="drill_tip"/>
  <joint name="drill_to_tip" type="fixed">
    <parent link="drill_link"/>
    <child link="drill_tip"/>
    <origin rpy="0 0 0" xyz="0 0 0.150"/>
  </joint>
</robot>
