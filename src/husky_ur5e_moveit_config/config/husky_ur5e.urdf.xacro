<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="husky_ur5e">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <xacro:include filename="$(find robot_gazebo)/models/robots/husky_ur5e.urdf" />

    <xacro:include filename="husky_ur5e.ros2_control.xacro" />


    <xacro:husky_ur5e_ros2_control name="UR5eArm" initial_positions_file="$(arg initial_positions_file)"/>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find husky_ur5e_moveit_config)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
