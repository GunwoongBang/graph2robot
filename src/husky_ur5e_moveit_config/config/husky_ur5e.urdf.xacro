<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="husky_ur5e">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import husky_ur5e urdf file -->
    <xacro:include filename="$(find robot_gazebo)/models/robots/husky_ur5e.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="husky_ur5e.ros2_control.xacro" />


    <xacro:husky_ur5e_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
